{
  "name": "vento-numera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3006",
    "build": "next build",
    "start": "next start --port 3006",
    "lint": "eslint",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "sync:navigation": "node scripts/sync-navigation.mjs",
    "prebuild": "node scripts/sync-navigation.mjs",
    "build:ci012": "node scripts/quality/numera-consumer-baseline-gate.mjs --prebuild-check --json && next build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:ci012",
    "test:ci012": "node --test scripts/quality/numera-consumer-baseline-gate.test.mjs",
    "ci012:baseline": "node scripts/quality/numera-consumer-baseline-gate.mjs --packages=@vento/contracts,@vento/os-context,@vento/supabase,@vento/ui-web --json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "next": "^16.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
